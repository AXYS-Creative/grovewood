<!-- prettier-ignore -->
{% set a11y_tab = 'tab-element-page' %}
{% set footer = global.footer_simple %}
{% set footer_class = 'footer-simple' %}

<!-- prettier-ignore -->
{% set include_top = footer.include_top | default(true) %}
{% set has_logo = footer.has_logo or null %}
{% set address = footer.address or '' %}
{% set phone = footer.phone or '' %}
{% set email = footer.email or '' %}
{% set social_media = footer.social_media or false %}

{% set linkset_1_title = footer.linkset_1_title or '' %}
{% set linkset_1 = footer.linkset_1 or null %}
{% set linkset_2_title = footer.linkset_2_title or '' %}
{% set linkset_2 = footer.linkset_2 or null %}
{% set linkset_3_title = footer.linkset_3_title or '' %}
{% set linkset_3 = footer.linkset_3 or null %}

{% set include_bottom = footer.include_bottom | default(true) %}
{% set divider = footer.divider | default(true) %}
{% set divider_width_full = footer.divider_width_full or false %}

{% set return_to_top = footer.return_to_top or false %}
{% set legal_links = footer.legal_links %}
{# `true` = fall back to the default for any falsy value, e.g. an empty string from the CMS, not just when the key is missing #}
{% set copyright = footer.copyright | default(
  '©<span data-current-year></span>
&nbsp;' + meta_data.site_name + '. All rights reserved', true ) %}

<!-- prettier-ignore -->
{% set footer_divider_class = '' %}
{%if divider_width_full%}
  {% set footer_divider_class = 'footer-simple__divider--width-full' %}
{%endif%}

<footer class="{{ footer_class }}" id="site-footer">
  <div class="footer-simple__inner">
    {% if include_top %}
    <div class="footer-simple__top">
      <div class="footer-simple__top-left">
        <!-- prettier-ignore -->
        {% if has_logo %}
          {% set logo = global.components.logo %}
          {% include "../components/logo.njk" %}
        {% endif %}

        <div class="footer-simple__top-contact">
          <!-- prettier-ignore -->
          {% if address %}
          <strong>Address:</strong>
          <!-- prettier-ignore -->
          {% set btn = ({ 
            text: address.text,
            url: address.url,
            type: address.type,
            new_tab: address.new_tab,
            class: address.class
          }) %}
          {% include "../components/btn.njk" %}
          {% endif %}

          <!-- prettier-ignore -->
          {% if phone %}
          <strong>Phone:</strong>
          <!-- prettier-ignore -->
          {% set btn = ({ 
            text: phone.text,
            url: phone.url,
            type: phone.type,
            new_tab: phone.new_tab,
            class: phone.class
          }) %} 
          {% include "../components/btn.njk" %} 
          {% endif %}

          <!-- prettier-ignore -->
          {% if email %}
          <strong>Email:</strong>
          <!-- prettier-ignore -->
          {% set btn = ({ 
            text: email.text,
            url: email.url,
            type: email.type,
            new_tab: email.new_tab,
            class: email.class
          }) %} 
          {% include "../components/btn.njk" %} 
          {% endif %}
        </div>

        <!-- prettier-ignore -->
        {% if social_media %}
          {% include "../components/social-media.njk" %}
        {% endif %}
      </div>

      <div class="footer-simple__top-right">
        <!-- prettier-ignore -->
        {% if linkset_1 %}
        <div class="footer-simple__linkset-1">
          {% if linkset_1_title %}
          <strong>{{ linkset_1_title }}</strong>
          {% endif %}

          <!-- prettier-ignore -->
          {% set menu_links = linkset_1 %}
          {% include "../components/menu-links.njk" %}
        </div>
        {% endif %}

        <!-- prettier-ignore -->
        {% if linkset_2 %}
        <div class="footer-simple__linkset-2">
          {% if linkset_2_title %}
          <strong>{{ linkset_2_title }}</strong>
          {% endif %}

          <!-- prettier-ignore -->
          {% set menu_links = linkset_2 %}
          {% include "../components/menu-links.njk" %}
        </div>
        {% endif %}

        <!-- prettier-ignore -->
        {% if linkset_3 %}
        <div class="footer-simple__linkset-2">
          {% if linkset_3_title %}
          <strong>{{ linkset_3_title }}</strong>
          {% endif %}

          <!-- prettier-ignore -->
          {% set menu_links = linkset_3 %}
          {% include "../components/menu-links.njk" %}
        </div>
        {% endif %}
      </div>
    </div>
    {% endif %}

    <!-- prettier-ignore -->
    {% if divider and include_bottom %}
    <hr class="footer-simple__divider {{ footer_divider_class }}" />
    {% endif %}

    <!-- prettier-ignore -->
    {% if include_bottom %}
    <div class="footer-simple__bottom">
      <!-- prettier-ignore -->
      {% if return_to_top %}
        {% set btn = ({
          text: return_to_top.text,
          type: return_to_top.type,
          icon_end: return_to_top.icon_end,
          class: ('back-to-top ' + (return_to_top.class or '')) | trim
        }) %}
        {% include "../components/btn.njk" %}
      {% endif %}
    
      {% if copyright %}
      <p class="footer-simple__copyright">{{ copyright | safe }}</p>
      {% endif %}

      <!-- prettier-ignore -->
      {% if legal_links %}
      <div class="footer-simple__bottom-group">
        <!-- prettier-ignore -->
        {% set menu_links = legal_links %}
        {% set menu_links_class = 'legal-links' %}
        {% include "../components/menu-links.njk" %}
      </div>
      {% endif %}
    </div>
    {% endif %}
  </div>
</footer>
