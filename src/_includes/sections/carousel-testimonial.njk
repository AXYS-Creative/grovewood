<!-- prettier-ignore -->
{% set eyebrow = carousel_testimonial.eyebrow or '' %}
{% set title = carousel_testimonial.title or '' %}
{% set class = carousel_testimonial.class or '' %}
{% set data = carousel_testimonial.carousel or {} %}
{% set section_id = carousel_testimonial.section_id or '' %}

{% if carousel_testimonial.toggle_section %}
<!-- prettier-ignore -->
<section class="carousel-testimonial {{ class }}" {% if section_id %}id="{{ section_id }}"{% endif %}>
  <div class="carousel-testimonial__inner">
    <div class="carousel-testimonial__head">
      <!-- prettier-ignore -->
      {% if eyebrow %}
      <small class="carousel-testimonial__eyebrow"> {{ eyebrow }} </small>
      {% endif %}

      <!-- prettier-ignore -->
      {% if title %}
      <h2 class="carousel-testimonial__title text-reveal">
        {{ title }}
      </h2>
      {% endif %}
    </div>

    <!-- Carousel mechanism lives in the shared carousel component. -->
    <!-- prettier-ignore -->
    {% set carousel = ({
      class: 'carousel-testimonial__carousel',
      pagination: data.pagination or 'arrows',
      drag: false if data.drag == false else true,
      drag_threshold: data.drag_threshold,
      label: data.label or (title or 'Testimonials'),
      btn_icon: data.btn_icon,
      slides: data.slides or [],
      slide_partial: './testimonial-card.njk'
    }) %}
    {% include "../components/carousel.njk" %}
  </div>
</section>
{% endif %}
