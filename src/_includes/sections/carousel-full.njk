<!-- prettier-ignore -->
{% set eyebrow = carousel_full.eyebrow or '' %}
{% set title = carousel_full.title or '' %}
{% set desc = carousel_full.desc or '' %}
{% set cta_1 = carousel_full.cta_1 or null %}
{% set cta_2 = carousel_full.cta_2 or null %}
{% set class = carousel_full.class or '' %}
{% set section_id = carousel_full.section_id or '' %}
{% set data = carousel_full.carousel or {} %}
{% set g = global.carousel_full or {} %}
{% set c = (data.custom or {}) if data.override_defaults else {} %}

{% if carousel_full.toggle_section %}
<!-- prettier-ignore -->
<section class="carousel-full {{ class }}" {% if section_id %}id="{{ section_id }}"{% endif %}>
  <div class="carousel-full__inner">
    <div class="carousel-full__head">
      <!-- prettier-ignore -->
      {% if eyebrow %}
      <small class="carousel-full__eyebrow"> {{ eyebrow }} </small>
      {% endif %}

      <!-- prettier-ignore -->
      {% if title %}
      <h2 class="carousel-full__title">{{ title }}</h2>
      {% endif %}

      <!-- prettier-ignore -->
      {% if desc %}
      <p class="carousel-full__desc">{{ desc | safe }}</p>
      {% endif %}

      <!-- prettier-ignore -->
      {% include "../components/cta-group.njk" %}
    </div>
  </div>

  <!-- Full-bleed carousel: centre one slide, crop the neighbours, dots + autoplay + loop. -->
  <!-- Behaviour settings come from global.carousel_full by default; a section can opt into -->
  <!-- its own values via carousel.override_defaults + carousel.custom in its data file. -->
  <!-- prettier-ignore -->
  {% set carousel = ({
    class: 'carousel-full__carousel',
    pagination: c.pagination or g.pagination or 'dots',
    align: c.align or g.align or 'center',
    loop: false if (c.loop if c.loop is defined else g.loop) == false else true,
    autoplay: (0 if (c.autoplay if c.autoplay is defined else g.autoplay) == 0 else ((c.autoplay if c.autoplay is defined else g.autoplay) or 6000)),
    drag: false if (c.drag if c.drag is defined else g.drag) == false else true,
    drag_threshold: c.drag_threshold if c.drag_threshold is defined else g.drag_threshold,
    pause_on_hover: false if (c.pause_on_hover if c.pause_on_hover is defined else g.pause_on_hover) == false else true,
    label: data.label or (title or 'Featured'),
    slides: data.slides or [],
    slide_partial: './carousel-panel.njk'
  }) %}
  {% include "../components/carousel.njk" %}
</section>
{% endif %}
