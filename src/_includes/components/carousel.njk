<!-- prettier-ignore -->
{% set slides = carousel.slides or [] %}
{% set slide_partial = carousel.slide_partial %}
{% set pagination = carousel.pagination or 'arrows' %}
{% set class = carousel.class or '' %}
{% set label = carousel.label or 'Carousel' %}
{% set drag = false if carousel.drag == false else true %}
{% set drag_threshold = carousel.drag_threshold %}
{% set btn_icon = carousel.btn_icon or '/static/img/icon-chevron-right.svg' %}

<!-- prettier-ignore -->
{# align: start (snap to left edge) | center (centre one slide, crop neighbours) #}
{% set align = carousel.align or 'start' %}
{# loop: infinite wrap. autoplay: ms between advances (0 / falsy = off) #}
{% set loop = true if carousel.loop else false %}
{% set autoplay = carousel.autoplay or 0 %}

{% if slides.length %}
<!-- prettier-ignore -->
<div
  class="carousel carousel--{{ pagination }}{% if align == 'center' %} carousel--center{% endif %} {{ class }}"
  data-carousel
  data-carousel-drag="{{ drag }}"
  {% if drag_threshold is defined %}data-carousel-drag-threshold="{{ drag_threshold }}"{% endif %}
  data-carousel-align="{{ align }}"
  {% if loop %}data-carousel-loop="true"{% endif %}
  {% if autoplay %}data-carousel-autoplay="{{ autoplay }}"{% endif %}
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ label }}"
>
  <div class="carousel__viewport" data-carousel-viewport>
    <ul class="carousel__track" data-carousel-track>
      {% for slide in slides %}
      <li
        class="carousel__slide"
        data-carousel-slide
        role="group"
        aria-roledescription="slide"
        aria-label="{{ loop.index }} of {{ slides.length }}"
      >
        <!-- prettier-ignore -->
        {% if slide_partial %}
        {% include slide_partial %}
        {% else %}
        {% if slide.title %}
        <h3 class="carousel__slide-title">{{ slide.title }}</h3>
        {% endif %} {% if slide.desc %}
        <p class="carousel__slide-desc">{{ slide.desc }}</p>
        {% endif %} {% endif %}
      </li>
      {% endfor %}
    </ul>
  </div>

  <!-- prettier-ignore -->
  {% if pagination == 'arrows' %}
  <div class="carousel__controls carousel__controls--arrows">
    <!-- prettier-ignore -->
    {% set btn = ({
      text_desc: 'Previous slide',
      type: 'secondary',
      class: 'carousel__arrow carousel__arrow--prev magnet',
      attributes: 'data-carousel-prev data-magnet-x="0.32" data-magnet-y="0.32" data-magnet-return-ease="cubic-bezier(0,1.64,.63,1.92)"',
      icon_size: 'lg',
      icon_start: btn_icon,
      icon_start_class: 'carousel__arrow-icon'
    }) %}
    {% include "./btn.njk" %}

    <!-- prettier-ignore -->
    {% set btn = ({
      text_desc: 'Next slide',
      type: 'secondary',
      class: 'carousel__arrow carousel__arrow--next magnet',
      attributes: 'data-carousel-next data-magnet-x="0.32" data-magnet-y="0.32" data-magnet-return-ease="cubic-bezier(0,1.64,.63,1.92)"',
      icon_size: 'lg',
      icon_end: btn_icon,
      icon_end_class: 'carousel__arrow-icon'
    }) %}
    {% include "./btn.njk" %}
  </div>
  {% endif %}

  <!-- prettier-ignore -->
  {% if pagination == 'dots' %}
  <div class="carousel__controls carousel__controls--dots">
    <div class="carousel__dots" data-carousel-dots></div>
  </div>
  {% endif %}
</div>
{% endif %}
